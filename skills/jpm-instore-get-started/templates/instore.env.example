# JPM In-Store (semi-integrated) configuration
# Copy this file to instore.env and fill in your values.
# Do NOT commit instore.env to source control.

# --- Terminal connection ---------------------------------------------------
# The terminal exposes a TLS WebSocket the POS connects to.
# This skill's default semi-integrated WebSocket port is 8442. Use the terminal's LAN IP.
#   wss://<terminal-ip>:8442
JPM_TERMINAL_HOST=
JPM_TERMINAL_PORT=8442

# --- Mandatory terminal identifier -----------------------------------------
# HWVENDORID is assigned by J.P. Morgan and MUST be set at startup via the
# SetParameter operation BEFORE any transaction. Placeholder only — fill from
# your onboarding artifacts. Do not commit the real value.
JPM_HWVENDORID=

# --- Environment -----------------------------------------------------------
# CAT = Customer Acceptance Testing (JPM test environment). PROD = production.
# Go-live to PROD is gated by JPM validation.
JPM_ENV=CAT
